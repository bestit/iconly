{
    "name": "@best-it/iconly",
    "version": "2.0.0-beta.1",
    "description": "SVG icon system utilising a custom element",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bestit/iconly.git"
    },
    "author": "best it GmbH <info@bestit.de>",
    "contributors": [
        {
            "name": "best it GmbH",
            "email": "info@bestit.de"
        },
        {
            "name": "Stephan Weber",
            "email": "steve-weber@web.de"
        }
    ],
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "lint": "eslint src tests vite.config.js",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "build": "vite build",
        "check:bundle": "node scripts/check-bundle.mjs",
        "publint": "publint --strict",
        "audit": "pnpm audit",
        "publish:public": "node scripts/publish.mjs public",
        "publish:beta": "node scripts/publish.mjs beta",
        "publish:dry": "node scripts/publish.mjs dry"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.55.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.14.0",
        "happy-dom": "^21.0.4",
        "publint": "^0.3.25",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
