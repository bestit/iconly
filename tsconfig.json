{
    "compilerOptions": {
        "moduleResolution": "node16",
        "module": "node16",
        "target": "es2016",
        "lib": [
            "es2022",
            "dom",
            "dom.iterable"
        ],
        "outDir": "dist",
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "declaration": false,
        "verbatimModuleSyntax": true,
        "strict": true
    },
    "files": [
        "./src/index.ts"
    ],
    "compileOnSave": false,
    "buildOnSave": false
}
