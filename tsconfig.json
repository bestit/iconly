{
    "compilerOptions": {
        "moduleResolution": "node16",
        "module": "node16",
        "target": "es2016",
        "lib": [
            "es2016",
            "dom"
        ],
        "outDir": "dist",
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "declaration": false,
        "verbatimModuleSyntax": true,
        "strict": true
    },
    "files": [
        "./src/index.ts"
    ],
    "compileOnSave": false,
    "buildOnSave": false
}
