{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "outDir": "dist",
        "rootDir": "src",
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "declaration": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true
    },
    "include": [
        "src/**/*.ts"
    ]
}
